{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/property-payload.schema.json",
  "title": "PropertyBatchPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["properties"],
  "properties": {
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Property"
      }
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street_address", "city", "state", "postal_code"],
      "properties": {
        "street_address": {
          "type": "string",
          "minLength": 3
        },
        "unit": {
          "type": ["string", "null"]
        },
        "city": {
          "type": "string",
          "minLength": 2
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "postal_code": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        }
      }
    },
    "Amenity": {
      "type": "string",
      "enum": [
        "central_ac",
        "forced_air_heating",
        "in_unit_laundry",
        "swimming_pool",
        "attached_garage",
        "fenced_yard",
        "hardwood_floors",
        "stainless_appliances",
        "solar_panels",
        "ev_charger"
      ]
    },
    "LocalSponsor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sponsor_id", "business_name", "category", "placement_tier"],
      "properties": {
        "sponsor_id": {
          "type": "string",
          "pattern": "^spn_[a-zA-Z0-9_-]+$"
        },
        "business_name": {
          "type": "string",
          "minLength": 2
        },
        "category": {
          "type": "string",
          "enum": ["lender", "insurance", "title_escrow", "general_contractor", "moving"]
        },
        "placement_tier": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+1[0-9]{10}$"
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "address",
        "price",
        "bedrooms",
        "bathrooms",
        "square_feet",
        "amenities",
        "zip_code",
        "local_sponsors"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "pattern": "^prop_[a-zA-Z0-9_-]+$"
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "price": {
          "type": "integer",
          "minimum": 1
        },
        "bedrooms": {
          "type": "integer",
          "minimum": 0
        },
        "bathrooms": {
          "type": "number",
          "minimum": 0.5
        },
        "square_feet": {
          "type": "integer",
          "minimum": 100
        },
        "amenities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Amenity"
          }
        },
        "zip_code": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "local_sponsors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalSponsor"
          }
        }
      }
    }
  }
}
